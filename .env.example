# Annotation Workspace — Configuration Template
#
# Copy this to .env and edit for your deployment.
# scripts/run.ps1 will load it and set environment variables.
#
# See SETUP.md for full documentation and examples.

# ============================================================================
# PROFILE: Choose one
# ============================================================================

# --- Local Dev (solo annotator) ---
# APP_ENV = "development"
# APP_HOST = "127.0.0.1"
# APP_PORT = "8765"
# CORS_ORIGINS = ""
# ALLOW_REGISTRATION = "1"
# DATABASE_URL = ""

# --- LAN Deployment (team of ~20–30) ---
# APP_ENV = "production"
# APP_HOST = "0.0.0.0"
# APP_PORT = "8000"
# JWT_SECRET = "abc123...xyz" (generated 64-hex string)
# CORS_ORIGINS = "http://192.168.1.81:8000"
# ALLOW_REGISTRATION = "0"
# DATABASE_URL = "postgresql+psycopg://annot:password@127.0.0.1:5432/annotation"
# DATA_DIR = "D:\annotation-data"

# --- Dev + Wildcard CORS (testing frontend) ---
# APP_ENV = "development"
# APP_HOST = "127.0.0.1"
# APP_PORT = "8765"
# CORS_ORIGINS = "*"
# ALLOW_REGISTRATION = "1"
# DATABASE_URL = ""

# ============================================================================
# INDIVIDUAL SETTINGS
# ============================================================================

APP_ENV = "development"
APP_HOST = "127.0.0.1"
APP_PORT = "8765"
JWT_SECRET = ""
CORS_ORIGINS = ""
ALLOW_REGISTRATION = "1"
MIN_PASSWORD_LENGTH = "8"

# Annotator manual, linked from the Help dialog. Served by a separate host on
# the LAN. Set to "" to hide the link.
MANUAL_URL = "http://192.168.110.150:8000/manual/"

DATABASE_URL = ""
DB_POOL_SIZE = "10"
DB_MAX_OVERFLOW = "20"
DB_POOL_TIMEOUT = "30"
DB_POOL_RECYCLE = "1800"

DATA_DIR = "."

MAX_UPLOAD_FILES = "200"
MAX_IMPORT_BYTES = "314572800"

COOKIE_SECURE = "0"
COOKIE_SAMESITE = "strict"

LOG_LEVEL = "INFO"
LOG_DIR = ""
LOG_MAX_BYTES = "10485760"
LOG_BACKUP_COUNT = "5"

# Team work-activity monitoring (ships OFF). Held in-process, so single uvicorn
# worker only. Turning MONITOR_ENABLED off is also the rollback.
# Keep the gap equal to the client idle timeout (timer.js IDLE_TIMEOUT_MS).
MONITOR_ENABLED = "0"
MONITOR_SESSION_GAP_SECONDS = "300"
MONITOR_FLUSH_SECONDS = "60"
MONITOR_BUFFER_MAX = "2000"
MONITOR_MAX_RANGE_DAYS = "31"

# Hull-condition semantic segmentation ("Hull" button). Off by default; needs
# the weights file in models/detector/ (or an absolute SEMSEG_MODEL path).
SEMSEG_ENABLED = "0"
SEMSEG_MODEL = "hull_semseg.pt"
SEMSEG_MIN_AREA_PX = "600"
SEMSEG_MAX_POLYGONS = "200"
# 0-1; pixels below this confidence are not drawn. 0 draws everything.
SEMSEG_MIN_CONFIDENCE = "0.6"
