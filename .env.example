# Annotation Workspace — Configuration Template
#
# Copy this to .env and edit for your deployment.
# scripts/run.ps1 will load it and set environment variables.
#
# See SETUP.md for full documentation and examples.

# ============================================================================
# PROFILE: Choose one
# ============================================================================

# --- Local Dev (solo annotator) ---
# APP_ENV = "development"
# APP_HOST = "127.0.0.1"
# APP_PORT = "8765"
# CORS_ORIGINS = ""
# ALLOW_REGISTRATION = "1"
# DATABASE_URL = ""

# --- LAN Deployment (team of ~20–30) ---
# APP_ENV = "production"
# APP_HOST = "0.0.0.0"
# APP_PORT = "8000"
# JWT_SECRET = "abc123...xyz" (generated 64-hex string)
# CORS_ORIGINS = "http://192.168.1.81:8000"
# ALLOW_REGISTRATION = "0"
# DATABASE_URL = "postgresql+psycopg://annot:password@127.0.0.1:5432/annotation"
# DATA_DIR = "D:\annotation-data"

# --- Dev + Wildcard CORS (testing frontend) ---
# APP_ENV = "development"
# APP_HOST = "127.0.0.1"
# APP_PORT = "8765"
# CORS_ORIGINS = "*"
# ALLOW_REGISTRATION = "1"
# DATABASE_URL = ""

# ============================================================================
# INDIVIDUAL SETTINGS
# ============================================================================

APP_ENV = "development"
APP_HOST = "127.0.0.1"
APP_PORT = "8765"
JWT_SECRET = ""
CORS_ORIGINS = ""
ALLOW_REGISTRATION = "1"
MIN_PASSWORD_LENGTH = "8"

DATABASE_URL = ""
DB_POOL_SIZE = "10"
DB_MAX_OVERFLOW = "20"
DB_POOL_TIMEOUT = "30"
DB_POOL_RECYCLE = "1800"

DATA_DIR = "."

MAX_UPLOAD_FILES = "200"
MAX_IMPORT_BYTES = "314572800"

COOKIE_SECURE = "0"
COOKIE_SAMESITE = "strict"

LOG_LEVEL = "INFO"
LOG_DIR = ""
LOG_MAX_BYTES = "10485760"
LOG_BACKUP_COUNT = "5"
